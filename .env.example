# Optional config
ZYNTALIC_DEFAULT_ENGINE=core
ZYNTALIC_MIRROR_RATE=0.8

# REST API limits and browser origins
ZYNTALIC_MAX_TEXT_CHARS=20000
ZYNTALIC_MAX_BATCH_ITEMS=32
ZYNTALIC_MAX_BATCH_CHARS=100000
ZYNTALIC_MAX_UPLOAD_BYTES=10485760
ZYNTALIC_CORS_ORIGINS=*

# SQLite WAL cache; increment the version after translation semantics change
ZYNTALIC_USE_CACHE=1
ZYNTALIC_CACHE_VERSION=2
# ZYNTALIC_CACHE_PATH=/data/zyntalic/translations.sqlite3
