# Optional config
# Where the service listens. Defaults to 8004 (zyntalic/netconfig.py). Deliberately not
# 8000 -- that is every dev server's default and collides with other local APIs.
# ZYNTALIC_PORT=8004
# ZYNTALIC_HOST=127.0.0.1
ZYNTALIC_DEFAULT_ENGINE=core
ZYNTALIC_MIRROR_RATE=0.8

# REST API limits and browser origins
# Generate a strong deployment secret, for example: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ZYNTALIC_API_KEY=replace-with-a-random-secret
# Keep disabled for network-facing servers. The desktop launcher enables it while binding to 127.0.0.1.
ZYNTALIC_ALLOW_UNAUTHENTICATED_LOCAL=0
ZYNTALIC_RATE_LIMIT_PER_MINUTE=60
ZYNTALIC_MAX_TEXT_CHARS=20000
ZYNTALIC_MAX_BATCH_ITEMS=32
ZYNTALIC_MAX_BATCH_CHARS=100000
ZYNTALIC_MAX_UPLOAD_BYTES=10485760
ZYNTALIC_CORS_ORIGINS=*

# SQLite WAL cache; increment the version after translation semantics change
ZYNTALIC_USE_CACHE=1
ZYNTALIC_CACHE_VERSION=2
# ZYNTALIC_CACHE_PATH=/data/zyntalic/translations.sqlite3
